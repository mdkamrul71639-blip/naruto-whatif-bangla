# ============================================
# NARUTO WHAT IF BANGLA SHORTS - ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in your values
# ============================================

# --------------------------------------------
# API KEYS (Required)
# --------------------------------------------

# Groq API Key (for fast script generation)
# Get from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# YouTube OAuth Credentials
# Get from Google Cloud Console: https://console.cloud.google.com
# 1. Create project -> Enable YouTube Data API v3
# 2. Create OAuth 2.0 Client ID (Desktop app)
# 3. Download JSON -> Save as config/client_secrets.json
# Then copy the ENTIRE JSON content here as a single line:
YOUTUBE_CLIENT_SECRETS={"installed":{"client_id":"...","project_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_secret":"...","redirect_uris":["http://localhost"]}}

# YouTube Token (generated after first auth)
# Run locally: python scripts/upload.py -> authorize in browser
# Then run: base64 config/token.pickle
# Paste the output here:
YOUTUBE_TOKEN_PICKLE=your_base64_encoded_token_pickle_here

# --------------------------------------------
# PIPELINE SETTINGS
# --------------------------------------------

# Output directory
OUTPUT_DIR=output

# LLM Backend: true = Ollama (local), false = Groq (cloud)
USE_OLLAMA=false

# Ollama Model (if USE_OLLAMA=true)
# Install: ollama pull llama3.1:8b
OLLAMA_MODEL=llama3.1:8b

# Groq Model (if USE_OLLAMA=false)
# Free tier available at console.groq.com
GROQ_MODEL=llama-3.1-8b-instant

# --------------------------------------------
# VIDEO SETTINGS (Shorts: 9:16 = 1080x1920)
# --------------------------------------------

VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# --------------------------------------------
# TTS VOICE (Bangla)
# --------------------------------------------

# Options:
# bn-IN-TanishaaNeural  - Natural female (India) - RECOMMENDED
# bn-IN-BashkarNeural   - Natural male (India)
# bn-BD-PradeepNeural   - Natural male (Bangladesh)
# bn-BD-NabanitaNeural  - Natural female (Bangladesh)
TTS_VOICE=bn-IN-TanishaaNeural

# --------------------------------------------
# AI IMAGE GENERATION (Pollinations.ai - Free)
# --------------------------------------------

# Model: sana (default), flux, turbo, dreamshaper
IMAGE_MODEL=sana
IMAGE_WIDTH=1080
IMAGE_HEIGHT=1920
IMAGE_NOLOGO=true

# --------------------------------------------
# AUDIO MIXING
# --------------------------------------------

# Background music volume (0.0 - 1.0)
BGM_VOLUME=0.15

# Sound effects volume (0.0 - 1.0)
SFX_VOLUME=0.3

# Main voiceover volume (0.0 - 1.0)
VOICE_VOLUME=1.0

# Transition duration between scenes (seconds)
TRANSITION_DURATION=0.5

# Enable fade transitions
ADD_TRANSITIONS=true

# --------------------------------------------
# YOUTUBE SETTINGS
# --------------------------------------------

# Category: 24=Entertainment, 20=Gaming, 22=People & Blogs
YOUTUBE_CATEGORY_ID=24

# Privacy: public, private, unlisted
YOUTUBE_PRIVACY_STATUS=public

# --------------------------------------------
# OPTIONAL: NOTIFICATIONS
# --------------------------------------------

# Telegram Bot Token (for notifications)
# TELEGRAM_TOKEN=your_bot_token
# TELEGRAM_CHAT_ID=your_chat_id

# --------------------------------------------
# DEFAULT TOPIC (fallback if topics.json missing)
# --------------------------------------------

DEFAULT_TOPIC=What If Naruto Had the Sharingan?